{
  "name": "rk-infogames",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de gerenciamento da RK Informática e Games",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.ts --dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
